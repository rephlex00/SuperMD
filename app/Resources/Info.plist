<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>SuperMD</string>
    <key>CFBundleExecutable</key>
    <string>SuperMD</string>
    <key>CFBundleIdentifier</key>
    <string>com.supermd.app</string>
    <key>CFBundleName</key>
    <string>SuperMD</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSUIElement</key>
    <false/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>SuperMD opens generated notes in Obsidian.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>SuperMD watches a folder under Documents (default ~/Documents/Supernote Inbox) and auto-converts any Supernote / PDF / PNG files saved there.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>SuperMD only reads files you drop on it or save into your Inbox folder. Access to Desktop is requested only if you pick a Desktop path as your Inbox or output.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Same as Documents — SuperMD only reads files you point it at (e.g. an AirDrop landing zone in Downloads).</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Supernote Note</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.supermd.note</string>
                <string>com.supermd.spd</string>
                <string>com.adobe.pdf</string>
                <string>public.png</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.supermd.note</string>
            <key>UTTypeDescription</key>
            <string>Supernote Note</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>note</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.supermd.spd</string>
            <key>UTTypeDescription</key>
            <string>Supernote SPD</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>spd</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
