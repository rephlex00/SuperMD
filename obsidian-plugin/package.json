{
  "name": "supermd-obsidian",
  "version": "0.1.0",
  "description": "Convert and view Supernote .note files in Obsidian via LLM vision transcription, with Supernote Cloud sync.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["obsidian", "supernote", "markdown", "ocr", "llm"],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/nunjucks": "^3.2.6",
    "@types/pako": "^2.0.3",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "nunjucks": "^3.2.4",
    "pako": "^2.1.0"
  }
}
